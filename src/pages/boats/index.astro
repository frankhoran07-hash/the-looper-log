---
import '../../styles/global.css';
import { supabase } from '../../lib/supabase';

// Fetch active listings from Supabase along with model clearance specs
const { data: listings } = await supabase
  .from('boat_listings')
  .select('*, boat_models(*)')
  .eq('status', 'active')
  .order('first_seen_at', { ascending: false });

const boats = listings || [];

// Helper to strip duplicate leading years from titles
function cleanBoatTitle(rawTitle, year) {
  let cleaned = (rawTitle || 'Vessel').trim();
  // Remove consecutive duplicate 4-digit years at the start (e.g., "2022 2022 Jeanneau" -> "2022 Jeanneau")
  cleaned = cleaned.replace(/^(\b\d{4}\b\s+)+/, '');
  if (year && !cleaned.startsWith(String(year))) {
    return `${year} ${cleaned}`;
  }
  return year ? `${year} ${cleaned}` : cleaned;
}

// Extract clean brand / makes for filter dropdown
const makesSet = new Set();
boats.forEach((b) => {
  let title = (b.boat_models?.make_model || b.title || '').trim();
  // Strip leading years
  title = title.replace(/^(\d{4}\s*)+/, '');
  const brand = title.split(' ')[0];
  if (brand && brand.length > 2 && isNaN(brand)) {
    makesSet.add(brand.charAt(0).toUpperCase() + brand.slice(1).toLowerCase());
  }
});
const uniqueMakes = Array.from(makesSet).sort();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Great Loop Vessels Market | The Looper Log</title>
    <style>
      * { box-sizing: border-box; }
      body {
        background-color: #0b1120;
        color: #f8fafc;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        margin: 0;
      }
      .filter-card {
        background-color: #151e32;
        border: 1px solid #23324d;
      }
      .boat-card {
        background-color: #151e32;
        border: 1px solid #23324d;
        border-radius: 0.85rem;
        transition: transform 0.15s ease, border-color 0.15s ease;
      }
      .boat-card:hover {
        border-color: #f59e0b;
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    
    <!-- Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
          <span>⚓</span>
          <span>The Looper Log</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-semibold">
          <a href="/boats" class="text-amber-400">Vessels</a>
          <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
          <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
          <a href="/community" class="text-slate-300 hover:text-amber-400 transition-colors">Community</a>
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
      
      <!-- Critical Clearance Milestones Banner -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Critical Clearance Milestones</span>
          <a href="/clearance" class="text-xs font-semibold text-amber-400 hover:underline">Test Your Boat Clearance &rarr;</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-5 rounded-xl filter-card">
          <div>
            <span class="text-xs uppercase text-slate-400 font-semibold block">Bridge Bottleneck</span>
            <span class="text-xl font-extrabold text-amber-400">19' 6"</span>
            <span class="text-xs text-slate-500 block">Chicago / Lemont Bridge</span>
          </div>
          <div>
            <span class="text-xs uppercase text-slate-400 font-semibold block">Max Water Draft</span>
            <span class="text-xl font-extrabold text-amber-400">5' 0"</span>
            <span class="text-xs text-slate-500 block">Canals &amp; River Shallows</span>
          </div>
          <div>
            <span class="text-xs uppercase text-slate-400 font-semibold block">Champlain Canal</span>
            <span class="text-xl font-extrabold text-amber-400">15' 6"</span>
            <span class="text-xs text-slate-500 block">Fixed bridges northward</span>
          </div>
          <div>
            <span class="text-xs uppercase text-slate-400 font-semibold block">Erie Canal (Eastern)</span>
            <span class="text-xl font-extrabold text-amber-400">21' 0"</span>
            <span class="text-xs text-slate-500 block">Waterford to Oswego cut</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar -->
      <div class="filter-card rounded-xl p-5 mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="filter-make" class="block text-xs font-semibold uppercase text-slate-400 mb-2">Filter by Make / Builder</label>
            <select id="filter-make" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-400">
              <option value="all">All Makes &amp; Models ({boats.length})</option>
              {uniqueMakes.map((m) => (
                <option value={m.toLowerCase()}>{m}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-price" class="block text-xs font-semibold uppercase text-slate-400 mb-2">Max Budget</label>
            <select id="filter-price" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-400">
              <option value="all">Any Price / Inquire</option>
              <option value="50000">Under $50,000</option>
              <option value="100000">Under $100,000</option>
              <option value="200000">Under $200,000</option>
              <option value="350000">Under $350,000</option>
              <option value="500000">Under $500,000</option>
            </select>
          </div>
          <div>
            <label for="filter-airdraft" class="block text-xs font-semibold uppercase text-slate-400 mb-2">Air Draft Compatibility</label>
            <select id="filter-airdraft" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-400">
              <option value="all">All Clearances</option>
              <option value="19.5">Chicago Route Clear (&le; 19.5 ft)</option>
              <option value="15.5">Champlain Route Clear (&le; 15.5 ft)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Headline & Count -->
      <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Loop Vessels Market</h1>
        <p id="boat-count" class="text-slate-400 text-sm mt-1">
          Showing {boats.length} Loop-capable boats monitored
        </p>
      </div>

      <!-- Vessels Grid -->
      <div id="vessels-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {boats.map((boat) => {
          const model = boat.boat_models || {};
          
          // Clear double year from title
          const displayTitle = cleanBoatTitle(boat.title || model.make_model, boat.year);

          // Numeric air and water draft parsing
          const rawAir = model.air_draft_clean_ft || model.air_draft_ft || boat.air_draft || 18.5;
          const airDraft = parseFloat(rawAir) || 18.5;
          const rawWater = model.water_draft_ft || boat.draft || 3.25;
          const waterDraft = parseFloat(rawWater) || 3.25;

          const cruiseSpeed = model.cruise_speed_knots || 16;
          const cruiseGph = model.gph_at_cruise || 22;

          // Price parsing
          const cleanPrice = parseFloat(String(boat.price || '0').replace(/[^0-9.]/g, '')) || 0;

          return (
            <div 
              class="boat-card p-5 flex flex-col justify-between"
              data-title={displayTitle.toLowerCase()}
              data-price={cleanPrice}
              data-airdraft={airDraft}
            >
              <div>
                <!-- Source Badge & Price Header -->
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-slate-800 text-slate-300 uppercase tracking-wider border border-slate-700">
                    {boat.source || 'BOATTRADER'}
                  </span>
                  <span class="text-lg font-extrabold text-amber-400">
                    {cleanPrice > 0 ? `$${cleanPrice.toLocaleString()} USD` : 'Inquire'}
                  </span>
                </div>

                <!-- Vessel Title -->
                <h2 class="text-base font-bold text-white mb-4 line-clamp-1">
                  {displayTitle}
                </h2>

                <!-- Specs Grid -->
                <div class="grid grid-cols-3 gap-2 py-3 border-y border-slate-800 text-xs mb-4">
                  <div>
                    <span class="text-slate-500 block font-medium">Air Draft</span>
                    <span class="font-bold text-slate-200">{airDraft} ft</span>
                  </div>
                  <div>
                    <span class="text-slate-500 block font-medium">Water Draft</span>
                    <span class="font-bold text-slate-200">{waterDraft} ft</span>
                  </div>
                  <div>
                    <span class="text-slate-500 block font-medium">Cruise / GPH</span>
                    <span class="font-bold text-slate-200">{cruiseSpeed} kts @ {cruiseGph} gph</span>
                  </div>
                </div>
              </div>

              <!-- Action Card Footer -->
              <div class="flex items-center justify-between pt-2">
                <span class="text-xs text-slate-500">
                  {boat.first_seen_at ? `Listed ${new Date(boat.first_seen_at).toLocaleDateString()}` : 'Active'}
                </span>
                <a 
                  href={`/boats/${boat.id}`} 
                  class="text-xs font-bold px-3 py-2 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 transition-colors"
                >
                  View Specs &rarr;
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </main>

    <footer class="border-t border-slate-800 bg-slate-900 py-8 text-center text-xs text-slate-500">
      <p>&copy; 2026 The Looper Log. Built for America's Great Loop cruisers.</p>
    </footer>

    <script is:inline>
      const makeSelect = document.getElementById('filter-make');
      const priceSelect = document.getElementById('filter-price');
      const airDraftSelect = document.getElementById('filter-airdraft');
      const countEl = document.getElementById('boat-count');
      const cards = document.querySelectorAll('.boat-card');

      function filterBoats() {
        const selectedMake = (makeSelect ? makeSelect.value : 'all').toLowerCase();
        const selectedPrice = priceSelect ? priceSelect.value : 'all';
        const selectedAirDraft = airDraftSelect ? airDraftSelect.value : 'all';
        let visibleCount = 0;

        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const price = parseFloat(card.getAttribute('data-price')) || 0;
          const airDraft = parseFloat(card.getAttribute('data-airdraft')) || 0;

          // 1. Make match
          const matchesMake = (selectedMake === 'all' || title.includes(selectedMake));

          // 2. Price match (if user chooses a budget limit, only show boats that actually fit the limit)
          let matchesPrice = true;
          if (selectedPrice !== 'all') {
            const maxBudget = parseFloat(selectedPrice);
            matchesPrice = price > 0 && price <= maxBudget;
          }

          // 3. Air draft clearance match
          let matchesAirDraft = true;
          if (selectedAirDraft !== 'all') {
            matchesAirDraft = airDraft <= parseFloat(selectedAirDraft);
          }

          if (matchesMake && matchesPrice && matchesAirDraft) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countEl) {
          countEl.textContent = `Showing ${visibleCount} Loop-capable boats monitored`;
        }
      }

      makeSelect?.addEventListener('change', filterBoats);
      priceSelect?.addEventListener('change', filterBoats);
      airDraftSelect?.addEventListener('change', filterBoats);
    </script>
  </body>
</html>