@'
---
import '../../styles/global.css';
import { supabase } from '../../lib/supabase';

const { data: listings, error } = await supabase
  .from('boat_listings')
  .select('*, boat_models(*)')
  .eq('status', 'active')
  .order('first_seen', { ascending: false });

const boats = listings || [];
const makes = [...new Set(boats.map(b => b.boat_models?.make_model || b.title).filter(Boolean))].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Loop Vessels Market | The Looper Log</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
          <span>⚓</span>
          <span>The Looper Log</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-semibold">
          <a href="/boats" class="text-amber-400">Vessels</a>
          <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
          <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
      <div class="mb-10">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Critical Clearance Milestones</span>
          <a href="/clearance" class="text-xs font-semibold text-amber-400 hover:underline">Test Your Boat Clearance &rarr;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-5 rounded-xl bg-slate-900/80 border border-slate-800">
          <div>
            <span class="text-xs uppercase text-slate-400 font-bold block">Bridge Bottleneck</span>
            <span class="text-xl font-extrabold text-amber-400">19' 6"</span>
            <span class="text-xs text-slate-500 block">Chicago / Lemont Bridge</span>
          </div>
          <div>
            <span class="text-xs uppercase text-slate-400 font-bold block">Max Water Draft</span>
            <span class="text-xl font-extrabold text-amber-400">5' 0"</span>
            <span class="text-xs text-slate-500 block">Canals & River Shallows</span>
          </div>
          <div>
            <span class="text-xs uppercase text-slate-400 font-bold block">Champlain Canal</span>
            <span class="text-xl font-extrabold text-amber-400">15' 6"</span>
            <span class="text-xs text-slate-500 block">Fixed bridges northward</span>
          </div>
          <div>
            <span class="text-xs uppercase text-slate-400 font-bold block">Erie Canal (Eastern)</span>
            <span class="text-xl font-extrabold text-amber-400">21' 0"</span>
            <span class="text-xs text-slate-500 block">Waterford to Oswego cut</span>
          </div>
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-5 mb-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase text-slate-400 mb-2">Filter by Boat Make / Model</label>
            <select id="filter-make" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-400">
              <option value="all">All Makes & Models ({boats.length})</option>
              {makes.map(m => (
                <option value={m}>{m}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase text-slate-400 mb-2">Max Budget</label>
            <select id="filter-price" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-amber-400">
              <option value="all">Any Price</option>
              <option value="50000">Under $50,000</option>
              <option value="100000">Under $100,000</option>
              <option value="200000">Under $200,000</option>
              <option value="350000">Under $350,000</option>