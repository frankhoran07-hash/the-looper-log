---
import '../../styles/global.css';
import { supabase } from '../../lib/supabase';

// Generate paths for all active listings in Supabase
export async function getStaticPaths() {
  const { data: listings } = await supabase
    .from('boat_listings')
    .select('id')
    .eq('status', 'active');

  return (listings || []).map((boat) => ({
    params: { id: boat.id },
  }));
}

const { id } = Astro.params;

// 1. Fetch boat listing with connected model specs
const { data: boat, error } = await supabase
  .from('boat_listings')
  .select('*, boat_models(*)')
  .eq('id', id)
  .single();

if (error || !boat) {
  return Astro.redirect('/404');
}

// 2. Fetch full price history snapshots for this listing
const { data: priceHistory } = await supabase
  .from('price_history')
  .select('*')
  .eq('listing_id', id)
  .order('recorded_at', { ascending: true });

// Clearance checkpoints
const airDraft = boat.boat_models?.air_draft_feet ?? null;
const waterDraft = boat.boat_models?.water_draft_feet ?? null;

const clearsChicago = airDraft !== null ? airDraft <= 19.5 : null;
const clearsChamplain = airDraft !== null ? airDraft <= 15.5 : null;
const clearsWaterDraft = waterDraft !== null ? waterDraft <= 5.0 : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{boat.title} | The Looper Log Specs & Price History</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen">
    <!-- Header -->
    <header class="border-b border-slate-800 bg-slate-950/80 sticky top-0 z-40 backdrop-blur">
      <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity">
          <span class="text-2xl">⚓</span>
          <div>
            <h1 class="text-xl font-bold tracking-tight text-amber-400">The Looper Log</h1>
            <p class="text-xs text-slate-400">Back to Vessel Market</p>
          </div>
        </a>
        <a
          href={boat.source_url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold px-4 py-2 rounded-lg bg-amber-400 text-slate-950 hover:bg-amber-300 transition-colors"
        >
          View on {boat.source_site.toUpperCase()} ↗
        </a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <!-- Title & Price Banner -->
      <div class="bg-slate-800/40 border border-slate-800 rounded-2xl p-6 mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold px-2.5 py-1 rounded bg-slate-700/60 text-slate-300">
            {boat.source_site} • Year {boat.year}
          </span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-100 mt-2">{boat.title}</h2>
          <p class="text-xs text-slate-400 mt-1">
            First tracked: {new Date(boat.first_seen_at).toLocaleDateString()} • Last confirmed: {new Date(boat.last_seen_at).toLocaleDateString()}
          </p>
        </div>
        <div class="text-left md:text-right">
          <span class="text-xs text-slate-400 block">Current Asking Price</span>
          <span class="text-3xl font-black text-amber-400">
            ${boat.current_asking_price.toLocaleString()} {boat.currency}
          </span>
        </div>
      </div>

      <!-- Great Loop Clearance Compatibility Gauge -->
      <section class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-6 mb-8">
        <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400 mb-4">
          Route Clearance Compatibility
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Chicago Bridge -->
          <div class={`p-4 rounded-xl border ${clearsChicago === true ? 'bg-emerald-950/30 border-emerald-500/40' : clearsChicago === false ? 'bg-rose-950/30 border-rose-500/40' : 'bg-slate-900 border-slate-800'}`}>
            <div class="flex justify-between items-center mb-1">
              <span class="text-xs font-semibold text-slate-300">Chicago Fixed Bridge</span>
              <span class="text-xs font-bold">{clearsChicago ? '✅ PASS' : clearsChicago === false ? '⚠️ FAIL' : 'UNKNOWN'}</span>
            </div>
            <p class="text-lg font-bold">{airDraft ? `${airDraft} ft` : 'Draft unverified'} <span class="text-xs font-normal text-slate-400">/ 19' 6" limit</span></p>
            <p class="text-[11px] text-slate-400 mt-1">Crucial bottleneck entering the Illinois River.</p>
          </div>

          <!-- Champlain Canal -->
          <div class={`p-4 rounded-xl border ${clearsChamplain === true ? 'bg-emerald-950/30 border-emerald-500/40' : clearsChamplain === false ? 'bg-amber-950/30 border-amber-500/40' : 'bg-slate-900 border-slate-800'}`}>
            <div class="flex justify-between items-center mb-1">
              <span class="text-xs font-semibold text-slate-300">Champlain Canal</span>
              <span class="text-xs font-bold">{clearsChamplain ? '✅ PASS' : clearsChamplain === false ? '⚠️ BYPASS REQ.' : 'UNKNOWN'}</span>
            </div>
            <p class="text-lg font-bold">{airDraft ? `${airDraft} ft` : 'Draft unverified'} <span class="text-xs font-normal text-slate-400">/ 15' 6" limit</span></p>
            <p class="text-[11px] text-slate-400 mt-1">If air draft &gt; 15' 6", use the Erie Canal / Oswego route.</p>
          </div>

          <!-- Water Draft -->
          <div class={`p-4 rounded-xl border ${clearsWaterDraft === true ? 'bg-emerald-950/30 border-emerald-500/40' : clearsWaterDraft === false ? 'bg-amber-950/30 border-amber-500/40' : 'bg-slate-900 border-slate-800'}`}>
            <div class="flex justify-between items-center mb-1">
              <span class="text-xs font-semibold text-slate-300">Water Draft (Locks)</span>
              <span class="text-xs font-bold">{clearsWaterDraft ? '✅ PASS' : clearsWaterDraft === false ? '⚠️ CAUTION' : 'UNKNOWN'}</span>
            </div>
            <p class="text-lg font-bold">{waterDraft ? `${waterDraft} ft` : 'Draft unverified'} <span class="text-xs font-normal text-slate-400">/ 5' 0" ideal</span></p>
            <p class="text-[11px] text-slate-400 mt-1">Canals & shallow tidal sections of the ICW.</p>
          </div>
        </div>
      </section>

      <!-- Technical Specs Grid -->
      {boat.boat_models && (
        <section class="bg-slate-800/40 border border-slate-800 rounded-2xl p-6 mb-8">
          <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400 mb-4">
            Vessel Standard Specifications
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
            <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
              <span class="text-slate-500 text-xs block">Hull Type</span>
              <span class="font-bold text-slate-200">{boat.boat_models.hull_type}</span>
            </div>
            <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
              <span class="text-slate-500 text-xs block">Beam</span>
              <span class="font-bold text-slate-200">{boat.boat_models.beam_feet} ft</span>
            </div>
            <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
              <span class="text-slate-500 text-xs block">Fuel Capacity</span>
              <span class="font-bold text-slate-200">{boat.boat_models.fuel_capacity_gal} gal</span>
            </div>
            <div class="bg-slate-900/80 p-3 rounded-lg border border-slate-800">
              <span class="text-slate-500 text-xs block">Cruising Economy</span>
              <span class="font-bold text-slate-200">
                {boat.boat_models.typical_cruise_speed_knots} kts @ {boat.boat_models.typical_gph} gph
              </span>
            </div>
          </div>
        </section>
      )}

      <!-- Price History Log -->
      <section class="bg-slate-800/40 border border-slate-800 rounded-2xl p-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-amber-400 mb-4">
          Recorded Price History ({priceHistory?.length || 0} Snapshots)
        </h3>

        {priceHistory && priceHistory.length > 0 ? (
          <div class="divide-y divide-slate-800">
            {priceHistory.map((p, idx) => (
              <div class="py-3 flex justify-between items-center text-sm">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                  <span class="text-slate-300 font-medium">
                    {new Date(p.recorded_at).toLocaleDateString(undefined, {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })}
                  </span>
                  {idx === 0 && (
                    <span class="text-[10px] bg-slate-800 border border-slate-700 text-slate-400 px-2 py-0.5 rounded">
                      First Spotted
                    </span>
                  )}
                </div>
                <span class="font-bold text-slate-100">
                  ${p.asking_price.toLocaleString()} USD
                </span>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-slate-500">Only initial listing price recorded so far.</p>
        )}
      </section>
    </main>
  </body>
</html>