---
export const prerender = true;

import '../../styles/global.css';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: boats, error } = await supabase
    .from('boat_listings')
    .select('*, boat_models(*)');

  if (error || !boats) {
    console.error("Error fetching boats for static paths:", error);
    return [];
  }

  return boats.map((boat) => ({
    params: { id: boat.id },
    props: { boat },
  }));
}

const { boat } = Astro.props;
const model = boat.boat_models || {};

// Clearance constants
const CHICAGO_AIR_DRAFT_LIMIT = 19.6;
const ERIE_AIR_DRAFT_LIMIT = 15.5;
const DRAFT_LIMIT = 5.0;

// Handle column names from both boat_models and boat_listings fallbacks
const airDraft = model.air_draft_feet != null
  ? parseFloat(model.air_draft_feet)
  : (parseFloat(boat.air_draft) || 0);

const draft = model.water_draft_feet != null
  ? parseFloat(model.water_draft_feet)
  : (parseFloat(boat.draft) || 0);

const beam = model.beam_feet != null
  ? parseFloat(model.beam_feet)
  : (parseFloat(boat.beam) || 0);

const passesChicago = airDraft > 0 && airDraft <= CHICAGO_AIR_DRAFT_LIMIT;
const passesErie = airDraft > 0 && airDraft <= ERIE_AIR_DRAFT_LIMIT;
const passesDraft = draft > 0 && draft <= DRAFT_LIMIT;

// Title and manufacturer fallback
const make = model.make || model.manufacturer || '';
const modelName = model.model_name || model.make_model || '';
const vesselTitle = boat.title || `${boat.year || ''} ${make} ${modelName}`.trim() || 'Vessel Specs';

// Clean price handling
const rawPrice = boat.current_asking_price ?? boat.price;
const numPrice = rawPrice ? parseFloat(String(rawPrice).replace(/[^0-9.]/g, '')) : 0;
const formattedPrice = numPrice > 0 ? `$${numPrice.toLocaleString()} USD` : 'Contact for Price';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{vesselTitle} | The Looper Log</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

    <!-- Header Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
          <span>⚓</span>
          <span>The Looper Log</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-semibold">
          <a href="/boats" class="text-amber-400">Vessels</a>
          <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
          <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
      <div class="mb-6">
        <a href="/boats" class="text-sm font-semibold text-slate-400 hover:text-amber-400 transition-colors flex items-center gap-1">
          ← Back to All Vessels
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left: Image & Overview -->
        <div class="lg:col-span-2 space-y-6">
          <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-900 shadow-xl">
            {boat.image_url ? (
              <img src={boat.image_url} alt={vesselTitle} class="w-full h-[420px] object-cover" />
            ) : (
              <div class="w-full h-[420px] bg-slate-800/60 flex items-center justify-center text-slate-600 text-6xl">
                ⚓
              </div>
            )}
          </div>

          <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-lg">
            <h1 class="text-3xl font-extrabold text-white">
              {vesselTitle}
            </h1>
            <p class="text-amber-400 text-2xl font-bold mt-2">
              {formattedPrice}
            </p>
            <p class="text-slate-400 text-sm mt-1">
              📍 Located in {boat.location || 'Location upon request'}
            </p>

            <hr class="border-slate-800 my-6" />

            <h2 class="text-lg font-bold text-white mb-3">Listing Details & Notes</h2>
            <p class="text-slate-300 leading-relaxed text-sm whitespace-pre-line">
              {boat.description || 'No detailed writeup provided for this vessel.'}
            </p>
          </div>
        </div>

        <!-- Right: Great Loop Clearance & Technical Specs -->
        <div class="space-y-6">
          
          <!-- Clearance Readiness Card -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-lg">
            <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span>🎯</span>
              <span>Great Loop Feasibility</span>
            </h2>

            <div class="space-y-4 text-sm">
              <div class="flex items-center justify-between p-3 rounded-lg bg-slate-950 border border-slate-800">
                <div>
                  <div class="font-semibold text-slate-200">Chicago Fixed Bridge</div>
                  <div class="text-xs text-slate-400">Max Air Draft: 19.6 ft</div>
                </div>
                {passesChicago ? (
                  <span class="px-2.5 py-1 text-xs font-bold rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">PASS</span>
                ) : (
                  <span class="px-2.5 py-1 text-xs font-bold rounded bg-rose-500/20 text-rose-400 border border-rose-500/30">FAIL</span>
                )}
              </div>

              <div class="flex items-center justify-between p-3 rounded-lg bg-slate-950 border border-slate-800">
                <div>
                  <div class="font-semibold text-slate-200">Erie Canal Western Route</div>
                  <div class="text-xs text-slate-400">Max Air Draft: 15.5 ft</div>
                </div>
                {passesErie ? (
                  <span class="px-2.5 py-1 text-xs font-bold rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">PASS</span>
                ) : (
                  <span class="px-2.5 py-1 text-xs font-bold rounded bg-rose-500/20 text-rose-400 border border-rose-500/30">FAIL</span>
                )}
              </div>

              <div class="flex items-center justify-between p-3 rounded-lg bg-slate-950 border border-slate-800">
                <div>
                  <div class="font-semibold text-slate-200">Waterway Water Depth</div>
                  <div class="text-xs text-slate-400">Recommended Draft: &le; 5.0 ft</div>
                </div>
                {passesDraft ? (
                  <span class="px-2.5 py-1 text-xs font-bold rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">PASS</span>
                ) : (
                  <span class="px-2.5 py-1 text-xs font-bold rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">CAUTION</span>
                )}
              </div>
            </div>
          </div>

          <!-- Vessel Specifications Card -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-lg">
            <h2 class="text-lg font-bold text-white mb-4">Specifications</h2>
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between py-1.5 border-b border-slate-800/60">
                <dt class="text-slate-400">Air Draft</dt>
                <dd class="font-semibold text-white">{airDraft ? `${airDraft} ft` : 'N/A'}</dd>
              </div>
              <div class="flex justify-between py-1.5 border-b border-slate-800/60">
                <dt class="text-slate-400">Water Draft</dt>
                <dd class="font-semibold text-white">{draft ? `${draft} ft` : 'N/A'}</dd>
              </div>
              <div class="flex justify-between py-1.5 border-b border-slate-800/60">
                <dt class="text-slate-400">Beam</dt>
                <dd class="font-semibold text-white">{beam ? `${beam} ft` : 'N/A'}</dd>
              </div>
              <div class="flex justify-between py-1.5 border-b border-slate-800/60">
                <dt class="text-slate-400">Length Overall (LOA)</dt>
                <dd class="font-semibold text-white">{model.length_feet ? `${model.length_feet} ft` : 'N/A'}</dd>
              </div>
              <div class="flex justify-between py-1.5 border-b border-slate-800/60">
                <dt class="text-slate-400">Fuel Type</dt>
                <dd class="font-semibold text-white">{model.fuel_type || 'Diesel'}</dd>
              </div>
              <div class="flex justify-between py-1.5">
                <dt class="text-slate-400">Hull Material</dt>
                <dd class="font-semibold text-white">{model.hull_material || 'Fiberglass'}</dd>
              </div>
            </dl>

            {boat.listing_url && (
              <a 
                href={boat.listing_url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="mt-6 block w-full text-center py-2.5 px-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg transition-colors shadow-md"
              >
                View Original Listing ↗
              </a>
            )}
          </div>

        </div>
      </div>
    </main>

    <footer class="border-t border-slate-800 bg-slate-900 py-6 text-center text-xs text-slate-500">
      <p>© 2026 The Looper Log. Built for America's Great Loop cruisers.</p>
    </footer>

  </body>
</html>