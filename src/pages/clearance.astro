---
export const prerender = true;

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Great Loop Clearance Checker | The Looper Log</title>
    <style>
      * { box-sizing: border-box; }
      body {
        background-color: #0b1120;
        color: #f8fafc;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        margin: 0;
      }
      .panel-card {
        background-color: #151e32;
        border: 1px solid #23324d;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    
    <!-- Header Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
          <span>⚓</span>
          <span>The Looper Log</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-semibold">
          <a href="/boats" class="text-slate-300 hover:text-amber-400 transition-colors">Vessels</a>
          <a href="/clearance" class="text-amber-400">Clearance Checker</a>
          <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
          <a href="/community" class="text-slate-300 hover:text-amber-400 transition-colors">Community</a>
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
      <div class="mb-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white">Great Loop Clearance Checker</h1>
        <p class="text-slate-400 text-sm mt-1">
          Enter your vessel's dimensions to evaluate pass/fail compatibility across every fixed bottleneck on the Loop.
        </p>
      </div>

      <!-- Input Form -->
      <div class="panel-card rounded-xl p-6 mb-8">
        <h2 class="text-base font-bold text-white mb-4">Enter Vessel Dimensions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="input-air" class="block text-xs uppercase font-semibold text-slate-400 mb-2">
              Air Draft (Bridge Clearance)
            </label>
            <div class="relative">
              <input
                type="number"
                id="input-air"
                step="0.1"
                min="0"
                placeholder="e.g. 17.5"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-amber-400 pr-10"
              />
              <span class="absolute right-3 top-2 text-xs text-slate-500 font-bold">ft</span>
            </div>
          </div>

          <div>
            <label for="input-water" class="block text-xs uppercase font-semibold text-slate-400 mb-2">
              Water Draft (Depth)
            </label>
            <div class="relative">
              <input
                type="number"
                id="input-water"
                step="0.1"
                min="0"
                placeholder="e.g. 3.8"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-amber-400 pr-10"
              />
              <span class="absolute right-3 top-2 text-xs text-slate-500 font-bold">ft</span>
            </div>
          </div>

          <div>
            <label for="input-beam" class="block text-xs uppercase font-semibold text-slate-400 mb-2">
              Beam (Width)
            </label>
            <div class="relative">
              <input
                type="number"
                id="input-beam"
                step="0.1"
                min="0"
                placeholder="e.g. 13.5"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-amber-400 pr-10"
              />
              <span class="absolute right-3 top-2 text-xs text-slate-500 font-bold">ft</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Results Grid -->
      <div id="results-container" class="space-y-4">
        <!-- Chicago / Lemont -->
        <div class="panel-card rounded-xl p-5 flex items-center justify-between" id="card-chicago">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base font-bold text-white">Chicago Route (Lemont Bridge)</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Hard Bottleneck</span>
            </div>
            <p class="text-xs text-slate-400 mt-1">Max Air Draft: <strong>19.5 ft</strong> &bull; Non-opening bridge required to access the Illinois River</p>
          </div>
          <span class="status-badge font-bold px-3 py-1 rounded text-xs bg-slate-800 text-slate-400" id="badge-chicago">Awaiting Input</span>
        </div>

        <!-- Champlain Canal -->
        <div class="panel-card rounded-xl p-5 flex items-center justify-between" id="card-champlain">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base font-bold text-white">Champlain Canal Route</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Northern Route</span>
            </div>
            <p class="text-xs text-slate-400 mt-1">Max Air Draft: <strong>15.5 ft</strong> &bull; Connects Hudson River to Lake Champlain and St. Lawrence</p>
          </div>
          <span class="status-badge font-bold px-3 py-1 rounded text-xs bg-slate-800 text-slate-400" id="badge-champlain">Awaiting Input</span>
        </div>

        <!-- Erie Canal (Waterford to Oswego) -->
        <div class="panel-card rounded-xl p-5 flex items-center justify-between" id="card-erie-oswego">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base font-bold text-white">Erie Canal to Oswego</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Canal Route</span>
            </div>
            <p class="text-xs text-slate-400 mt-1">Max Air Draft: <strong>21.0 ft</strong> &bull; Connects Hudson River to Lake Ontario through Three Rivers</p>
          </div>
          <span class="status-badge font-bold px-3 py-1 rounded text-xs bg-slate-800 text-slate-400" id="badge-erie-oswego">Awaiting Input</span>
        </div>

        <!-- Western Erie Canal -->
        <div class="panel-card rounded-xl p-5 flex items-center justify-between" id="card-erie-west">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base font-bold text-white">Western Erie Canal (Three Rivers to Buffalo)</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Extreme Low Bridge</span>
            </div>
            <p class="text-xs text-slate-400 mt-1">Max Air Draft: <strong>15.5 ft</strong> &bull; Low bridges between Syracuse and Niagara</p>
          </div>
          <span class="status-badge font-bold px-3 py-1 rounded text-xs bg-slate-800 text-slate-400" id="badge-erie-west">Awaiting Input</span>
        </div>

        <!-- Water Draft / Canal Locks -->
        <div class="panel-card rounded-xl p-5 flex items-center justify-between" id="card-draft">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base font-bold text-white">Water Draft &amp; River Channels</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Depth</span>
            </div>
            <p class="text-xs text-slate-400 mt-1">Recommended Max: <strong>5.0 ft</strong> &bull; Canal shoaling and inland river locks during low pools</p>
          </div>
          <span class="status-badge font-bold px-3 py-1 rounded text-xs bg-slate-800 text-slate-400" id="badge-draft">Awaiting Input</span>
        </div>

        <!-- Trent-Severn Waterway (Beam & Lock Clearance) -->
        <div class="panel-card rounded-xl p-5 flex items-center justify-between" id="card-trent">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-base font-bold text-white">Trent-Severn Waterway (Big Chute Railway)</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Canadian Cut</span>
            </div>
            <p class="text-xs text-slate-400 mt-1">Max Draft: <strong>4.0 ft</strong> &bull; Max Beam: <strong>23.0 ft</strong> &bull; Big Chute marine railway limits</p>
          </div>
          <span class="status-badge font-bold px-3 py-1 rounded text-xs bg-slate-800 text-slate-400" id="badge-trent">Awaiting Input</span>
        </div>
      </div>
    </main>

    <footer class="border-t border-slate-800 bg-slate-900 py-8 text-center text-xs text-slate-500">
      <p>&copy; 2026 The Looper Log. Built for America's Great Loop cruisers.</p>
    </footer>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const airInput = document.getElementById('input-air');
        const waterInput = document.getElementById('input-water');
        const beamInput = document.getElementById('input-beam');

        function setBadge(el, state, text) {
          if (!el) return;
          el.textContent = text;
          el.className = 'status-badge font-bold px-3 py-1 rounded text-xs';
          
          if (state === 'pass') {
            el.classList.add('bg-emerald-950', 'text-emerald-400', 'border', 'border-emerald-800');
          } else if (state === 'warn') {
            el.classList.add('bg-amber-950', 'text-amber-400', 'border', 'border-amber-800');
          } else if (state === 'fail') {
            el.classList.add('bg-rose-950', 'text-rose-400', 'border', 'border-rose-800');
          } else {
            el.classList.add('bg-slate-800', 'text-slate-400');
          }
        }

        function evaluateClearances() {
          const air = parseFloat(airInput.value);
          const water = parseFloat(waterInput.value);
          const beam = parseFloat(beamInput.value);

          // Chicago (19.5 max)
          const badgeChicago = document.getElementById('badge-chicago');
          if (!isNaN(air)) {
            if (air <= 19.5) {
              setBadge(badgeChicago, 'pass', `CLEAR (${(19.5 - air).toFixed(1)}' margin)`);
            } else {
              setBadge(badgeChicago, 'fail', `EXCEEDED (+${(air - 19.5).toFixed(1)}' over)`);
            }
          } else {
            setBadge(badgeChicago, 'neutral', 'Awaiting Air Draft');
          }

          // Champlain (15.5 max)
          const badgeChamplain = document.getElementById('badge-champlain');
          if (!isNaN(air)) {
            if (air <= 15.5) {
              setBadge(badgeChamplain, 'pass', `CLEAR (${(15.5 - air).toFixed(1)}' margin)`);
            } else if (air <= 19.0) {
              setBadge(badgeChamplain, 'warn', `REQUIRES DROP (+${(air - 15.5).toFixed(1)}')`);
            } else {
              setBadge(badgeChamplain, 'fail', `EXCEEDED (+${(air - 15.5).toFixed(1)}' over)`);
            }
          } else {
            setBadge(badgeChamplain, 'neutral', 'Awaiting Air Draft');
          }

          // Erie to Oswego (21.0 max)
          const badgeErieOswego = document.getElementById('badge-erie-oswego');
          if (!isNaN(air)) {
            if (air <= 21.0) {
              setBadge(badgeErieOswego, 'pass', `CLEAR (${(21.0 - air).toFixed(1)}' margin)`);
            } else {
              setBadge(badgeErieOswego, 'fail', `EXCEEDED (+${(air - 21.0).toFixed(1)}' over)`);
            }
          } else {
            setBadge(badgeErieOswego, 'neutral', 'Awaiting Air Draft');
          }

          // Western Erie (15.5 max)
          const badgeErieWest = document.getElementById('badge-erie-west');
          if (!isNaN(air)) {
            if (air <= 15.5) {
              setBadge(badgeErieWest, 'pass', `CLEAR (${(15.5 - air).toFixed(1)}' margin)`);
            } else {
              setBadge(badgeErieWest, 'fail', `EXCEEDED (+${(air - 15.5).toFixed(1)}' over)`);
            }
          } else {
            setBadge(badgeErieWest, 'neutral', 'Awaiting Air Draft');
          }

          // Water Draft (5.0 recommended max)
          const badgeDraft = document.getElementById('badge-draft');
          if (!isNaN(water)) {
            if (water <= 4.0) {
              setBadge(badgeDraft, 'pass', `EXCELLENT (${water}' draft)`);
            } else if (water <= 5.0) {
              setBadge(badgeDraft, 'warn', `MARGINAL (${water}' draft)`);
            } else {
              setBadge(badgeDraft, 'fail', `HIGH RISK (+${(water - 5.0).toFixed(1)}' shoaling risk)`);
            }
          } else {
            setBadge(badgeDraft, 'neutral', 'Awaiting Water Draft');
          }

          // Trent-Severn (4.0 draft max, 23 beam max)
          const badgeTrent = document.getElementById('badge-trent');
          if (!isNaN(water) || !isNaN(beam)) {
            const draftOk = isNaN(water) || water <= 4.0;
            const beamOk = isNaN(beam) || beam <= 23.0;
            if (draftOk && beamOk) {
              setBadge(badgeTrent, 'pass', 'CLEAR');
            } else if (!draftOk) {
              setBadge(badgeTrent, 'fail', `DRAFT EXCEEDED (+${(water - 4.0).toFixed(1)}')`);
            } else {
              setBadge(badgeTrent, 'fail', `BEAM EXCEEDED (+${(beam - 23.0).toFixed(1)}')`);
            }
          } else {
            setBadge(badgeTrent, 'neutral', 'Awaiting Dimensions');
          }
        }

        airInput?.addEventListener('input', evaluateClearances);
        waterInput?.addEventListener('input', evaluateClearances);
        beamInput?.addEventListener('input', evaluateClearances);
      });
    </script>
  </body>
</html>