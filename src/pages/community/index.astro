---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Community Discussions | The Looper Log</title>
  <style>
    body {
      background-color: #020617;
      color: #f8fafc;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      padding: 0;
    }
    a { text-decoration: none; }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-950 text-slate-100">

  <!-- Header Navigation -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
        <span>⚓</span>
        <span>The Looper Log</span>
      </a>
      <nav class="flex items-center gap-6 text-sm font-semibold">
        <a href="/boats" class="text-slate-300 hover:text-amber-400 transition-colors">Vessels</a>
        <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
        <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
        <a href="/community" class="text-amber-400 transition-colors">Community</a>
      </nav>
    </div>
  </header>

  <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-2">
        Community Discussions
      </h1>
      <p class="text-slate-400 text-base max-w-2xl">
        Connect with fellow Great Loopers, compare experiences across waterways, and share advice on bottlenecks, anchorages, and gear.
      </p>
    </div>

    <!-- Topics Container -->
    <div id="topics-container" class="grid grid-cols-1 gap-4">
      <div class="bg-slate-900/40 border border-slate-800 rounded-xl p-8 text-center text-slate-400">
        Loading discussion topics...
      </div>
    </div>
  </main>

  <footer class="border-t border-slate-800 py-8 bg-slate-950 mt-auto">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
      &copy; 2026 The Looper Log. Built for America's Great Loop cruisers.
    </div>
  </footer>

  <script is:inline>
    const SUPABASE_URL = 'https://xrdxysgnjrtvvvovozkb.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhyZHh5c2duanJ0dnZ2b3ZvemtiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE0Nzk1NzcsImV4cCI6MjEwNzA1NTU3N30.o6w3MNo2iBSoN2i_kZ73PAIJH5IXVZEIIelQS-1vyzM';

    async function fetchTopics() {
      const container = document.getElementById('topics-container');
      try {
        const [resTopics, resComments] = await Promise.all([
          fetch(SUPABASE_URL + '/rest/v1/forum_topics?select=id,title,slug,description,created_at&order=created_at.desc', {
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': 'Bearer ' + SUPABASE_KEY
            }
          }),
          fetch(SUPABASE_URL + '/rest/v1/forum_comments?select=topic_slug&approved=eq.true', {
            headers: {
              'apikey': SUPABASE_KEY,
              'Authorization': 'Bearer ' + SUPABASE_KEY
            }
          })
        ]);

        const topics = await resTopics.json();
        const comments = await resComments.json();

        const counts = {};
        if (Array.isArray(comments)) {
          comments.forEach(function(c) {
            counts[c.topic_slug] = (counts[c.topic_slug] || 0) + 1;
          });
        }

        if (Array.isArray(topics) && topics.length > 0) {
          container.innerHTML = topics.map(function(t) {
            const count = counts[t.slug] || 0;
            const replyText = count === 1 ? '1 reply' : count + ' replies';
            return '<a href="/community/' + t.slug + '" class="block bg-slate-900 border border-slate-800 rounded-xl p-6 hover:border-amber-500/50 hover:bg-slate-900/80 transition-all duration-200">' +
              '<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">' +
                '<div class="space-y-2 flex-grow">' +
                  '<h2 class="text-lg sm:text-xl font-bold text-white hover:text-amber-400 transition-colors">' +
                    t.title +
                  '</h2>' +
                  '<p class="text-slate-300 text-sm line-clamp-2 leading-relaxed">' +
                    (t.description || '') +
                  '</p>' +
                '</div>' +
                '<div class="flex items-center shrink-0 text-xs text-amber-400 font-semibold">' +
                  '<span class="px-3 py-1 rounded-full bg-slate-800 border border-slate-700">💬 ' + replyText + '</span>' +
                '</div>' +
              '</div>' +
            '</a>';
          }).join('');
        } else {
          container.innerHTML = '<div class="bg-slate-900/40 border border-slate-800 rounded-xl p-8 text-center text-slate-400">No topics found.</div>';
        }
      } catch (err) {
        console.error(err);
        container.innerHTML = '<div class="bg-slate-900/40 border border-red-800 rounded-xl p-8 text-center text-red-400">Error loading topics. Please refresh.</div>';
      }
    }

    fetchTopics();
  </script>
</body>
</html>