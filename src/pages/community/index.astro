---
export const prerender = true;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://xrdxysgnjrtvvvovozkb.supabase.co';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhyZHh5c2duanJ0dnZ2b3ZvemtiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE0Nzk1NzcsImV4cCI6MjEwNzA1NTU3N30.o6w3MNo2iBSoN2i_kZ73PAIJH5IXVZEIIelQS-1vyzM';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Community Discussions | The Looper Log</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #0b1120;
      color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    a { text-decoration: none; color: inherit; }

    /* Header Nav */
    header {
      background-color: #0f172a;
      border-bottom: 1px solid #1e293b;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .header-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.25rem;
      height: 4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand {
      color: #f59e0b;
      font-weight: 800;
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: 0.025em;
    }
    nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      font-size: 0.9rem;
      font-weight: 600;
    }
    nav a { color: #94a3b8; transition: color 0.15s ease; }
    nav a:hover, nav a.active { color: #f59e0b; }

    /* Main Container */
    main {
      flex: 1;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      padding: 2.5rem 1.25rem;
    }
    .page-title {
      font-size: 2.25rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }
    .page-subtitle {
      color: #94a3b8;
      font-size: 1rem;
      line-height: 1.5;
      margin-bottom: 2rem;
    }

    /* Cards */
    #topics-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .topic-card {
      display: block;
      background-color: #151e32;
      border: 1px solid #23324d;
      border-radius: 0.75rem;
      padding: 1.5rem;
      transition: all 0.2s ease;
    }
    .topic-card:hover {
      background-color: #1a263f;
      border-color: #f59e0b;
      transform: translateY(-1px);
    }
    .topic-row {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    @media (min-width: 640px) {
      .topic-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }
    .topic-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: #f1f5f9;
      margin-bottom: 0.35rem;
      transition: color 0.15s ease;
    }
    .topic-card:hover .topic-title { color: #f59e0b; }
    .topic-desc {
      color: #94a3b8;
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .reply-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background-color: #0f172a;
      border: 1px solid #334155;
      color: #f59e0b;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.4rem 0.85rem;
      border-radius: 9999px;
      white-space: nowrap;
      align-self: flex-start;
    }

    /* Footer */
    footer {
      border-top: 1px solid #1e293b;
      background-color: #0b1120;
      padding: 2rem 1.25rem;
      text-align: center;
      color: #64748b;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <header>
    <div class="header-inner">
      <a href="/" class="brand">
        <span>⚓</span>
        <span>The Looper Log</span>
      </a>
      <nav>
        <a href="/boats">Vessels</a>
        <a href="/clearance">Clearance</a>
        <a href="/map">Hazard Map</a>
        <a href="/community" class="active">Community</a>
      </nav>
    </div>
  </header>

  <main>
    <h1 class="page-title">Community Discussions</h1>
    <p class="page-subtitle">
      Connect with fellow Great Loopers, check regional river updates, and share advice on bottlenecks, anchorages, and gear.
    </p>

    <div id="topics-container">
      <div style="background:#151e32; border:1px solid #23324d; padding:2rem; border-radius:0.75rem; text-align:center; color:#94a3b8;">
        Loading discussion topics...
      </div>
    </div>
  </main>

  <footer>
    &copy; 2026 The Looper Log. Built for America's Great Loop cruisers.
  </footer>

  <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
    document.addEventListener('DOMContentLoaded', () => {
      async function fetchTopics() {
        const container = document.getElementById('topics-container');
        if (!container) return;

        try {
          const [resTopics, resComments] = await Promise.all([
            fetch(supabaseUrl + '/rest/v1/forum_topics?select=id,title,slug,description,created_at&order=created_at.desc', {
              headers: {
                'apikey': supabaseAnonKey,
                'Authorization': 'Bearer ' + supabaseAnonKey
              }
            }),
            fetch(supabaseUrl + '/rest/v1/forum_comments?select=topic_slug&approved=eq.true', {
              headers: {
                'apikey': supabaseAnonKey,
                'Authorization': 'Bearer ' + supabaseAnonKey
              }
            })
          ]);

          const topics = await resTopics.json();
          const comments = await resComments.json();

          const counts = {};
          if (Array.isArray(comments)) {
            comments.forEach(function(c) {
              counts[c.topic_slug] = (counts[c.topic_slug] || 0) + 1;
            });
          }

          if (Array.isArray(topics) && topics.length > 0) {
            container.innerHTML = topics.map(function(t) {
              const count = counts[t.slug] || 0;
              const replyText = count === 1 ? '1 reply' : count + ' replies';
              return '<a href="/community/' + t.slug + '" class="topic-card">' +
                '<div class="topic-row">' +
                  '<div style="flex:1;">' +
                    '<div class="topic-title">' + t.title + '</div>' +
                    '<div class="topic-desc">' + (t.description || '') + '</div>' +
                  '</div>' +
                  '<div>' +
                    '<span class="reply-badge">💬 ' + replyText + '</span>' +
                  '</div>' +
                '</div>' +
              '</a>';
            }).join('');
          } else {
            container.innerHTML = '<div style="background:#151e32; padding:2rem; border-radius:0.75rem; text-align:center; color:#94a3b8;">No topics found.</div>';
          }
        } catch (err) {
          console.error(err);
          container.innerHTML = '<div style="background:#151e32; padding:2rem; border-radius:0.75rem; text-align:center; color:#f87171;">Error loading topics. Please refresh.</div>';
        }
      }

      fetchTopics();
    });
  </script>
</body>
</html>