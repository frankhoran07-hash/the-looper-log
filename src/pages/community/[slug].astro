---
export const prerender = true;

import '../../styles/global.css';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  try {
    const { data: posts, error } = await supabase
      .from('community_posts')
      .select('*');

    if (error || !posts || posts.length === 0) {
      return [];
    }

    return posts.map((post) => ({
      params: { slug: post.slug || post.id },
      props: { post },
    }));
  } catch (err) {
    return [];
  }
}

const { post } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post?.title || 'Community Update'} | The Looper Log</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

    <!-- Header Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
          <span>⚓</span>
          <span>The Looper Log</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-semibold">
          <a href="/boats" class="text-slate-300 hover:text-amber-400 transition-colors">Vessels</a>
          <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
          <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
      <div class="mb-6">
        <a href="/" class="text-sm font-semibold text-slate-400 hover:text-amber-400 transition-colors flex items-center gap-1">
          ← Back to Overview
        </a>
      </div>

      <article class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-10 shadow-xl space-y-6">
        <div>
          <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded bg-amber-500/20 text-amber-400 border border-amber-500/30">
            {post?.category || 'Field Notes'}
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-3 leading-tight">
            {post?.title || 'Untitled Update'}
          </h1>
          <div class="flex items-center gap-4 text-xs text-slate-400 mt-3 pb-4 border-b border-slate-800">
            <span>By <strong class="text-slate-300">{post?.author || 'Fellow Looper'}</strong></span>
            {post?.created_at && (
              <span>• {new Date(post.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            )}
          </div>
        </div>

        {post?.image_url && (
          <div class="rounded-xl overflow-hidden border border-slate-800">
            <img src={post.image_url} alt={post.title || 'Community entry image'} class="w-full max-h-[400px] object-cover" />
          </div>
        )}

        <div class="text-slate-300 leading-relaxed space-y-4 text-base whitespace-pre-line">
          {post?.content || 'No entry details provided.'}
        </div>
      </article>
    </main>

    <footer class="border-t border-slate-800 bg-slate-900 py-6 text-center text-xs text-slate-500">
      <p>© 2026 The Looper Log. Built for America's Great Loop cruisers.</p>
    </footer>

  </body>
</html>