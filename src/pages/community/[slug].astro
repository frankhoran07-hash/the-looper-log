---
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

export async function getStaticPaths() {
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;
  const supabase = createClient(supabaseUrl, supabaseKey);

  const { data: topics } = await supabase
    .from('forum_topics')
    .select('slug');

  return (topics || []).map((t) => ({
    params: { slug: t.slug },
  }));
}

const { slug } = Astro.params;

// Fetch topic details
const { data: topic } = await supabase
  .from('forum_topics')
  .select('*')
  .eq('slug', slug)
  .single();

// Fetch approved comments for this topic
const { data: comments } = await supabase
  .from('forum_comments')
  .select('*')
  .eq('topic_slug', slug)
  .eq('approved', true)
  .order('created_at', { ascending: true });
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{topic ? topic.title : 'Topic'} | The Looper Log</title>
  <link rel="stylesheet" href="/src/styles/global.css" />
  <style>
    body {
      background-color: #020617;
      color: #f8fafc;
      font-family: ui-sans-serif, system-ui, sans-serif;
      margin: 0;
      padding: 0;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-950 text-slate-100">

  <!-- Header Navigation -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
        <span>⚓</span>
        <span>The Looper Log</span>
      </a>
      <nav class="flex items-center gap-6 text-sm font-semibold">
        <a href="/boats" class="text-slate-300 hover:text-amber-400 transition-colors">Vessels</a>
        <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
        <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
        <a href="/community" class="text-amber-400 transition-colors">Community</a>
      </nav>
    </div>
  </header>

  <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
    <div class="mb-6">
      <a href="/community" class="text-amber-400 hover:text-amber-300 text-sm font-medium flex items-center gap-2">
        &larr; Back to all discussions
      </a>
    </div>

    {topic ? (
      <div>
        <!-- Topic Header -->
        <article class="bg-slate-900 border border-slate-800 rounded-xl p-6 sm:p-8 mb-8 shadow-sm">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
            {topic.title}
          </h1>
          <p class="text-slate-300 text-base leading-relaxed">
            {topic.description}
          </p>
        </article>

        <!-- Comments List -->
        <section class="mb-10">
          <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
            <span>Replies</span>
            <span class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full border border-slate-700">
              {comments ? comments.length : 0}
            </span>
          </h2>

          {comments && comments.length > 0 ? (
            <div class="space-y-4">
              {comments.map((c) => (
                <div class="bg-slate-900/60 border border-slate-800 rounded-lg p-5">
                  <div class="flex items-center justify-between mb-3 text-xs text-slate-400 border-b border-slate-800/60 pb-2">
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-amber-400">{c.author_name || 'Anonymous Cruiser'}</span>
                      {c.boat_name && (
                        <span class="text-slate-500">• m/v {c.boat_name}</span>
                      )}
                    </div>
                    <span>{new Date(c.created_at).toLocaleDateString()}</span>
                  </div>
                  <p class="text-slate-200 text-sm whitespace-pre-wrap leading-relaxed">
                    {c.comment_text}
                  </p>
                </div>
              ))}
            </div>
          ) : (
            <div class="bg-slate-900/30 border border-dashed border-slate-800 rounded-lg p-8 text-center text-slate-400 text-sm">
              No replies on this topic yet. Be the first to share advice or insights!
            </div>
          )}
        </section>

        <!-- Add Comment Form -->
        <section class="bg-slate-900 border border-slate-800 rounded-xl p-6 sm:p-8">
          <h3 class="text-lg font-bold text-white mb-4">Post a Comment</h3>
          
          <form id="comment-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="author_name" class="block text-xs font-semibold text-slate-300 mb-1">Your Name *</label>
                <input
                  type="text"
                  id="author_name"
                  name="author_name"
                  required
                  placeholder="e.g. Captain Dan"
                  class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400"
                />
              </div>
              <div>
                <label for="boat_name" class="block text-xs font-semibold text-slate-300 mb-1">Boat Name (Optional)</label>
                <input
                  type="text"
                  id="boat_name"
                  name="boat_name"
                  placeholder="e.g. Sea Nomad"
                  class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400"
                />
              </div>
            </div>

            <div>
              <label for="comment_text" class="block text-xs font-semibold text-slate-300 mb-1">Message *</label>
              <textarea
                id="comment_text"
                name="comment_text"
                rows="4"
                required
                placeholder="Share your experience, updates, or tips for this topic..."
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3.5 py-2 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-amber-400"
              ></textarea>
            </div>

            <div id="status-box" class="hidden text-sm p-3 rounded-lg"></div>

            <button
              type="submit"
              id="submit-btn"
              class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-5 py-2.5 rounded-lg text-sm transition-colors cursor-pointer"
            >
              Post Comment
            </button>
          </form>
        </section>
      </div>
    ) : (
      <div class="text-center py-20">
        <h2 class="text-2xl font-bold text-white mb-2">Topic Not Found</h2>
        <p class="text-slate-400 text-sm mb-6">This discussion topic doesn't exist or has been removed.</p>
        <a href="/community" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-2 rounded-lg text-sm">
          Return to Community
        </a>
      </div>
    )}
  </main>

  <footer class="border-t border-slate-800 py-8 bg-slate-950 mt-auto">
    <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
      &copy; 2026 The Looper Log. Built for America's Great Loop cruisers.
    </div>
  </footer>

  <script define:vars={{ slug, supabaseUrl, supabaseKey }}>
    const form = document.getElementById('comment-form');
    const statusBox = document.getElementById('status-box');
    const submitBtn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Submitting...';

        const author_name = document.getElementById('author_name').value.trim();
        const boat_name = document.getElementById('boat_name').value.trim();
        const comment_text = document.getElementById('comment_text').value.trim();

        try {
          const res = await fetch(`${supabaseUrl}/rest/v1/forum_comments`, {
            method: 'POST',
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`,
              'Content-Type': 'application/json',
              'Prefer': 'return=minimal'
            },
            body: JSON.stringify({
              topic_slug: slug,
              author_name,
              boat_name: boat_name || null,
              comment_text,
              approved: true
            })
          });

          if (!res.ok) {
            const err = await res.text();
            throw new Error(err || 'Failed to submit comment');
          }

          statusBox.className = 'text-sm p-3 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
          statusBox.innerText = 'Comment posted successfully! Refreshing...';
          statusBox.classList.remove('hidden');
          form.reset();

          setTimeout(() => {
            window.location.reload();
          }, 1200);
        } catch (err) {
          statusBox.className = 'text-sm p-3 rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20';
          statusBox.innerText = `Error: ${err.message || 'Unable to submit comment. Please try again.'}`;
          statusBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerText = 'Post Comment';
        }
      });
    }
  </script>
</body>
</html>