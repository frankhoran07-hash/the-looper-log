---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Looper Log | Great Loop Community, Vessels & Hazards">
  <!-- Hero Section -->
  <section class="relative bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img 
        src="/hero-loop-map.jpg" 
        alt="The Looper Log Great Loop Navigation Map" 
        class="w-full h-full object-cover object-center"
      />
    </div>
    <div class="relative max-w-6xl mx-auto px-4 py-24 sm:py-32 flex flex-col items-center text-center">
      <span class="inline-block py-1 px-3 mb-4 text-xs font-semibold uppercase tracking-wider bg-amber-500/20 text-amber-300 rounded-full border border-amber-500/40">
        6,000 Miles • 150+ Locks • One Community
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight max-w-3xl leading-tight">
        Plan, Cruise, and Connect on America's Great Loop
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed">
        The centralized hub built by and for Loopers. Search proven vessels with accurate bridge clearances, pin real-time navigation hazards, and exchange knowledge.
      </p>
      
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/map" class="px-6 py-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold transition">
          View Hazards Map
        </a>
        <a href="/boats" class="px-6 py-3 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-white font-semibold border border-slate-700 transition">
          Search Loop Vessels
        </a>
        <a href="/forum" class="px-6 py-3 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-white font-semibold border border-slate-700 transition">
          Community Forum
        </a>
      </div>
    </div>
  </section>

  <!-- Core Hub Feature Cards -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Feature 1: Vessel Finder -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between hover:shadow-md transition">
        <div>
          <div class="w-12 h-12 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xl mb-4">
            ⚓
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Vessel Directory</h2>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Filter trawlers, tugs, and motor yachts that clear the fixed 19.6 ft bridge clearance in Chicago and respect river draft limits.
          </p>
        </div>
        <a href="/boats" class="text-sm font-semibold text-blue-600 hover:text-blue-800">
          Browse Vessels &rarr;
        </a>
      </div>

      <!-- Feature 2: Hazard Map -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between hover:shadow-md transition">
        <div>
          <div class="w-12 h-12 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xl mb-4">
            📍
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Hazard Lookout</h2>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Community-sourced navigational alerts: mark shifting shoals, deadhead logs, lock maintenance closures, and low bridges in real time.
          </p>
        </div>
        <a href="/map" class="text-sm font-semibold text-amber-600 hover:text-amber-800">
          Explore the Map &rarr;
        </a>
      </div>

      <!-- Feature 3: Community Forum -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 flex flex-col justify-between hover:shadow-md transition">
        <div>
          <div class="w-12 h-12 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xl mb-4">
            💬
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Cruiser Exchange</h2>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Connect with planners, in-progress cruisers, and Gold Loopers. Share anchorage coordinates, fuel stops, and weather strategies.
          </p>
        </div>
        <a href="/forum" class="text-sm font-semibold text-emerald-600 hover:text-emerald-800">
          Join the Discussion &rarr;
        </a>
      </div>

    </div>
  </section>
</Layout>