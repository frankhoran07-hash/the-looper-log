---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Looper Log | Great Loop Community & Vessel Hub</title>
  <meta name="description" content="Plan, Cruise, and Connect on America's Great Loop. Search verified vessels, check bridge clearances, track live hazards, and participate in community discussions." />
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-amber-500 selection:text-slate-950">

  <!-- Header / Navigation -->
  <header class="border-b border-slate-800/80 bg-slate-950/90 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-amber-400 font-bold text-lg tracking-wide hover:text-amber-300 transition-colors">
        <span class="text-xl">⚓</span>
        <span>The Looper Log</span>
      </a>
      <nav class="flex items-center gap-6 text-sm font-medium text-slate-300">
        <a href="/boats" class="hover:text-amber-400 transition-colors">Vessels</a>
        <a href="/clearance" class="hover:text-amber-400 transition-colors">Clearance Checker</a>
        <a href="/map" class="hover:text-amber-400 transition-colors">Hazard Map</a>
        <a href="/community" class="hover:text-amber-400 transition-colors">Community</a>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <main class="flex-1 flex flex-col justify-between">
    <section class="relative py-20 px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center justify-center overflow-hidden">
      <!-- Background Map Image -->
      <div 
        class="absolute inset-0 bg-cover bg-center opacity-25 filter contrast-125"
        style="background-image: url('/hero-map.jpg'); background-color: #0b1120;"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/40 via-slate-950/80 to-slate-950"></div>

      <!-- Content -->
      <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20 mb-6">
          6,000 Miles • 150+ Locks • Cruiser Community
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
          Plan, Cruise, and Connect on <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-amber-200">America's Great Loop</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mb-8 leading-relaxed">
          The centralized hub built by and for Loopers. Search verified vessels with bridge clearance checks, track live navigational hazards, and share knowledge from the helm.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/map" class="px-6 py-3 rounded-lg text-sm font-semibold text-slate-950 bg-amber-400 hover:bg-amber-300 shadow-lg shadow-amber-400/20 transition-all">
            Explore Hazard Map
          </a>
          <a href="/boats" class="px-6 py-3 rounded-lg text-sm font-semibold text-white bg-slate-900 border border-slate-700 hover:bg-slate-800 transition-all">
            Search Loop Vessels
          </a>
          <a href="/clearance" class="px-6 py-3 rounded-lg text-sm font-semibold text-white bg-slate-900 border border-slate-700 hover:bg-slate-800 transition-all">
            Clearance Checker
          </a>
          <a href="/community" class="px-6 py-3 rounded-lg text-sm font-semibold text-white bg-slate-900 border border-slate-700 hover:bg-slate-800 transition-all">
            Community Discussions
          </a>
        </div>
      </div>
    </section>

    <!-- Feature Grid Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Card 1: Vessels -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 text-lg mb-4">
              ⚓
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Vessel Directory</h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4">
              Filter loop-ready trawlers, motor yachts, and tugs vetted against fixed bridge obstacles (19.6 ft in Chicago) and inland draft depth restrictions.
            </p>
          </div>
          <a href="/boats" class="text-amber-400 text-xs sm:text-sm font-semibold inline-flex items-center gap-1 hover:text-amber-300">
            Browse Vessels <span>→</span>
          </a>
        </div>

        <!-- Card 2: Hazard Map -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <div class="w-10 h-10 rounded-lg bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 text-lg mb-4">
              📍
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Hazard Lookout Map</h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4">
              Crowdsourced warnings from the helm: track shifting shoals, deadheads, lock repairs, and temporary bridge air-draft limitations.
            </p>
          </div>
          <a href="/map" class="text-amber-400 text-xs sm:text-sm font-semibold inline-flex items-center gap-1 hover:text-amber-300">
            View Live Alerts <span>→</span>
          </a>
        </div>

        <!-- Card 3: Clearance Calculator -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <div class="w-10 h-10 rounded-lg bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400 text-lg mb-4">
              📐
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Clearance Calculator</h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4">
              Test any boat dimensions against the fixed bottlenecks along the loop: Lemont Bridge (19' 6"), Champlain Canal (15' 6"), and eastern Erie Canal (21' 0").
            </p>
          </div>
          <a href="/clearance" class="text-amber-400 text-xs sm:text-sm font-semibold inline-flex items-center gap-1 hover:text-amber-300">
            Calculate Clearance <span>→</span>
          </a>
        </div>

        <!-- Card 4: Community Discussions -->
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 text-lg mb-4">
              💬
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Community Forum</h3>
            <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4">
              Ask questions, share updates, and connect with fellow Great Loopers on route planning, lock timing, gear setups, and anchorages.
            </p>
          </div>
          <a href="/community" class="text-amber-400 text-xs sm:text-sm font-semibold inline-flex items-center gap-1 hover:text-amber-300">
            Join Discussions <span>→</span>
          </a>
        </div>

      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800/60 bg-slate-950 py-6 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4">
      © 2026 The Looper Log. Built for America's Great Loop cruisers.
    </div>
  </footer>

</body>
</html>