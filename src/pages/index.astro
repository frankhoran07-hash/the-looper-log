---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Looper Log | Great Loop Community, Vessels & Hazards</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

    <!-- Header Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
          <span>⚓</span>
          <span>The Looper Log</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-semibold">
          <a href="/boats" class="text-slate-300 hover:text-amber-400 transition-colors">Vessels</a>
          <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
          <a href="/map" class="text-slate-300 hover:text-amber-400 transition-colors">Hazard Map</a>
          <a href="/community" class="text-slate-300 hover:text-amber-400 transition-colors">Community</a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="relative bg-slate-900 text-white overflow-hidden border-b border-slate-800">
      <div class="absolute inset-0 opacity-25">
        <img
          src="/hero-loop-map.jpg"
          alt="The Looper Log Great Loop Navigation Map"
          class="w-full h-full object-cover object-center"
        />
      </div>
      <div class="relative max-w-5xl mx-auto px-4 py-20 sm:py-28 flex flex-col items-center text-center">
        <span class="inline-block py-1 px-3 mb-4 text-xs font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 rounded-full border border-amber-500/40">
          6,000 Miles • 150+ Locks • Cruiser Community
        </span>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight mb-6 leading-tight">
          Plan, Cruise, and Connect on <br class="hidden sm:inline" />
          <span class="text-amber-400">America's Great Loop</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mb-10 leading-relaxed font-light">
          The centralized hub built by and for Loopers. Search verified vessels with bridge clearance checks, track live navigational hazards, and share knowledge from the helm.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/map" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 py-3.5 rounded-lg shadow-lg shadow-amber-500/10 transition-colors">
            Explore Hazard Map
          </a>
          <a href="/boats" class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 font-semibold px-6 py-3.5 rounded-lg transition-colors">
            Search Loop Vessels
          </a>
          <a href="/clearance" class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 font-semibold px-6 py-3.5 rounded-lg transition-colors">
            Clearance Checker
          </a>
        </div>
      </div>
    </section>

    <!-- Main Feature Grid -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Card 1 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 bg-amber-500/10 rounded-lg flex items-center justify-center text-amber-400 text-2xl mb-6 border border-amber-500/20">
              ⚓
            </div>
            <h2 class="text-xl font-bold text-white mb-3">Vessel Directory</h2>
            <p class="text-sm text-slate-400 leading-relaxed mb-6">
              Filter loop-ready trawlers, motor yachts, and tugs vetted against fixed bridge obstacles (19.6 ft in Chicago) and inland draft depth restrictions.
            </p>
          </div>
          <a href="/boats" class="text-amber-400 hover:text-amber-300 font-semibold text-sm flex items-center gap-2">
            Browse Vessels <span>&rarr;</span>
          </a>
        </div>

        <!-- Card 2 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 bg-rose-500/10 rounded-lg flex items-center justify-center text-rose-400 text-2xl mb-6 border border-rose-500/20">
              📍
            </div>
            <h2 class="text-xl font-bold text-white mb-3">Hazard Lookout Map</h2>
            <p class="text-sm text-slate-400 leading-relaxed mb-6">
              Crowdsourced warnings from the helm: track shifting shoals, deadheads, lock repairs, and temporary bridge air-draft limitations.
            </p>
          </div>
          <a href="/map" class="text-amber-400 hover:text-amber-300 font-semibold text-sm flex items-center gap-2">
            View Live Alerts <span>&rarr;</span>
          </a>
        </div>

        <!-- Card 3 -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 bg-blue-500/10 rounded-lg flex items-center justify-center text-blue-400 text-2xl mb-6 border border-blue-500/20">
              📐
            </div>
            <h2 class="text-xl font-bold text-white mb-3">Clearance Calculator</h2>
            <p class="text-sm text-slate-400 leading-relaxed mb-6">
              Test any boat dimensions against the fixed bottlenecks along the loop: Lemont Bridge (19' 6"), Champlain Canal (15' 6"), and eastern Erie Canal (21' 0").
            </p>
          </div>
          <a href="/clearance" class="text-amber-400 hover:text-amber-300 font-semibold text-sm flex items-center gap-2">
            Calculate Clearance <span>&rarr;</span>
          </a>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 py-8 bg-slate-950">
      <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
        &copy; 2026 The Looper Log. Built for America's Great Loop cruisers.
      </div>
    </footer>

  </body>
</html>