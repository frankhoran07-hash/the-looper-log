---
export const prerender = true;

import '../styles/global.css';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hazard Lookout Map | The Looper Log</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">

    <!-- Header Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-amber-400 font-extrabold text-xl tracking-wide">
          <span>⚓</span>
          <span>The Looper Log</span>
        </a>
        <nav class="flex items-center gap-6 text-sm font-semibold">
          <a href="/boats" class="text-slate-300 hover:text-amber-400 transition-colors">Vessels</a>
          <a href="/clearance" class="text-slate-300 hover:text-amber-400 transition-colors">Clearance Checker</a>
          <a href="/map" class="text-amber-400">Hazard Map</a>
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">
      <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="text-3xl font-extrabold text-white">Great Loop Hazard Map</h1>
          <p class="text-slate-400 text-sm mt-1">Real-time alerts, shoals, lock delays, and submerged hazards reported along the route.</p>
        </div>
        <span class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/40 px-3 py-1.5 rounded-md font-medium">
          💡 Double-click on the map to place a warning marker
        </span>
      </div>

      <!-- Map Canvas -->
      <div id="map" class="w-full h-[680px] rounded-xl border border-slate-800 shadow-2xl z-0"></div>
    </main>

    <footer class="border-t border-slate-800 bg-slate-900 py-6 text-center text-xs text-slate-500">
      <p>© 2026 The Looper Log. Built for America's Great Loop cruisers.</p>
    </footer>

    <!-- Leaflet & Supabase Persistence Script -->
    <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
      window.addEventListener('load', async () => {
        if (!window.supabase) {
          console.error("Supabase JS failed to load.");
          return;
        }

        const client = window.supabase.createClient(supabaseUrl, supabaseAnonKey);
        const map = L.map('map', { doubleClickZoom: false }).setView([36.5, -85.0], 5);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        function createPopupContent(h) {
          const deleteBtn = h.id 
            ? `<button onclick="window.deleteHazard('${h.id}')" style="color: #dc2626; background: none; border: none; cursor: pointer; font-size: 11px; font-weight: 600; padding: 0;">Delete</button>` 
            : '';

          return `
            <div style="font-family: sans-serif; font-size: 13px; color: #0f172a; min-width: 180px;">
              <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: #b91c1c;">${h.category || 'shoal'}</span><br/>
              <strong style="font-size: 14px;">${h.title}</strong>
              <p style="margin: 6px 0 4px 0; color: #334155;">${h.description || 'No description provided.'}</p>
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #64748b; border-top: 1px solid #e2e8f0; padding-top: 6px; margin-top: 6px;">
                <span>${h.reported_by || 'Anonymous Cruiser'}</span>
                ${deleteBtn}
              </div>
            </div>
          `;
        }

        window.deleteHazard = async (id) => {
          if (!id) return;
          if (!confirm("Are you sure you want to remove this hazard?")) return;

          const { error } = await client
            .from('hazard_markers')
            .delete()
            .eq('id', id);

          if (error) {
            console.error("Supabase delete error:", error);
            alert("Failed to delete hazard: " + error.message);
            return;
          }

          location.reload();
        };

        // Fetch existing hazard markers live from Supabase
        const { data: markers, error: fetchErr } = await client
          .from('hazard_markers')
          .select('*')
          .order('created_at', { ascending: false });

        if (fetchErr) {
          console.error("Error fetching live hazards:", fetchErr);
        } else if (markers) {
          markers.forEach((h) => {
            L.marker([h.latitude, h.longitude])
              .addTo(map)
              .bindPopup(createPopupContent(h));
          });
        }

        // Double-click handler to insert into Supabase and place marker
        map.on('dblclick', async (e) => {
          const title = prompt("Enter hazard title (e.g. 'Shallow Shoal at Low Tide'):");
          if (!title || !title.trim()) return;

          const description = prompt("Enter details/notes for other cruisers:") || '';

          const newHazard = {
            title: title.trim(),
            description: description.trim(),
            category: 'shoal',
            reported_by: 'Anonymous Cruiser',
            latitude: e.latlng.lat,
            longitude: e.latlng.lng
          };

          const { data, error } = await client
            .from('hazard_markers')
            .insert([newHazard])
            .select();

          if (error) {
            console.error("Supabase insert error:", error);
            alert("Error saving hazard: " + error.message);
            return;
          }

          const savedHazard = (data && data[0]) ? data[0] : newHazard;

          L.marker([savedHazard.latitude, savedHazard.longitude])
            .addTo(map)
            .bindPopup(createPopupContent(savedHazard))
            .openPopup();
        });
      });
    </script>
  </body>
</html>